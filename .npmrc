# Install dependencies without running lifecycle scripts.
ignore-scripts=true

# Do not resolve dependency releases until they are 14 full days old.
min-release-age=14

# These packages are released by this project/team and must be available
# immediately to this package's release train.
min-release-age-exclude[]=@photostructure/tz-lookup
min-release-age-exclude[]=batch-cluster
min-release-age-exclude[]=exiftool-vendored.exe
min-release-age-exclude[]=exiftool-vendored.pl

# Preserve this package's established bare MAJOR.MINOR.PATCH tag convention.
tag-version-prefix=
